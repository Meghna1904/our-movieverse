# Copy this file to .env and fill in your values

# Supabase project settings (find these in your Supabase dashboard → Settings → API)
SUPABASE_PROJECT_ID="your_project_id"
SUPABASE_URL="https://your_project_id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Same values prefixed with VITE_ so they're available client-side if needed
VITE_SUPABASE_PROJECT_ID="your_project_id"
VITE_SUPABASE_URL="https://your_project_id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Site password — users must enter this to access the app
SITE_PASSWORD="choose_a_password"

# A long random string used to sign session cookies (keep this secret!)
SESSION_SECRET="a-very-long-random-secret-string-at-least-32-chars"

# OMDb API key — free at https://www.omdbapi.com/apikey.aspx (just enter your email)
OMDB_API_KEY="your_omdb_api_key"
